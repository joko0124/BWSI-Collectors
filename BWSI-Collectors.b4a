ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'For more information: http://www.b4x.com/forum/showthread.php?p=78136~\n~~\n~AddManifestText(~\n~    <uses-sdk android:minSdkVersion="5" android:targetSdkVersion="29"/>~\n~    ~\n~    <!-- Permissions -->~\n~    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>~\n~    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>~\n~    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>~\n~    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"/>~\n~    <uses-permission android:name="android.permission.INTERNET"/>~\n~    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>~\n~    ~\n~    <!-- Screen Support -->~\n~    <supports-screens ~\n~        android:largeScreens="true" ~\n~        android:normalScreens="true"~\n~        android:smallScreens="true"~\n~        android:anyDensity="true"/>~\n~)~\n~~\n~'<!-- Features -->~\n~AddManifestText(<uses-feature android:name="android.hardware.telephony" android:required="false" />)~\n~AddManifestText(<uses-feature android:name="android.hardware.camera" android:required="false" />)~\n~AddManifestText(<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />)~\n~AddManifestText(<uses-feature android:name="android.hardware.camera.flash" android:required="false" />)~\n~~\n~'<!-- Libraries -->~\n~AddApplicationText(<uses-library android:name="org.apache.http.legacy" android:required="false" />)~\n~~\n~'<!-- Application Attributes -->~\n~SetManifestAttribute(android:installLocation, "auto")~\n~SetApplicationAttribute(android:usesCleartextTraffic, "true")~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~SetApplicationAttribute(android:largeHeap, "true")~\n~SetApplicationAttribute(android:allowBackup, "false")~\n~SetApplicationAttribute(android:requestLegacyExternalStorage, true)~\n~~\n~'<!-- Activity Attributes -->~\n~SetActivityAttribute(Main, android:windowSoftInputMode, adjustPan|stateHidden)~\n~SetActivityAttribute(Main, "android:excludeFromRecents", "false")~\n~~\n~'<!-- Theme -->~\n~SetApplicationAttribute(android:theme, "@style/MyAppTheme")~\n~~\n~'<!-- Colors -->~\n~CreateResource(values, colors.xml,~\n~<resources>~\n~    <color name="actionbar">#0b4f6c</color>~\n~	<color name="statusbar">#007CF5</color>~\n~    <color name="textColorPrimary">#ffffff</color>~\n~    <color name="navigationBar">#006db3</color>~\n~    <color name="colorAccent">#1E4369</color>~\n~</resources>~\n~)~\n~~\n~'<!-- Themes -->~\n~CreateResource(values, themes.xml,~\n~<resources>~\n~    <style name="MyAppTheme" parent="Theme.AppCompat.Light.NoActionBar">~\n~        <item name="colorPrimary">#0098FF</item> <!-- Action Bar Color -->~\n~        <item name="colorPrimaryDark">@color/statusbar</item> <!-- Status Bar Color -->~\n~        <item name="colorAccent">#AAAA00</item>~\n~        <item name="windowNoTitle">true</item>~\n~        <item name="windowActionBar">false</item>~\n~        <item name="android:windowDrawsSystemBarBackgrounds">true</item> <!-- Required -->~\n~        <item name="android:statusBarColor">@color/statusbar</item> <!-- Set Status Bar Color -->~\n~	</style>~\n~</resources>~\n~)~\n~~\n~'<!-- Floating Hint Style -->~\n~CreateResource(values, fle.xml,~\n~<resources>~\n~    <style name="floating_hint" parent="@style/Theme.AppCompat.Light">~\n~        <item name="android:textColor">#01579b</item>~\n~        <item name="android:textSize">16dp</item>~\n~    </style>~\n~</resources>~\n~)~\n~~\n~'<!-- Additional Permissions -->~\n~AddPermission(android.permission.ACCESS_SUPERUSER)~\n~AddPermission(android.permission.CHANGE_WIFI_STATE)~\n~AddPermission(android.permission.ACCESS_WIFI_STATE)~\n~AddPermission(android.permission.BLUETOOTH)~\n~AddPermission(android.permission.BLUETOOTH_ADMIN)~\n~AddPermission(android.permission.BLUETOOTH_PRIVILEGED)~\n~AddPermission(android.permission.BIND_PRINT_SERVICE)~\n~AddPermission(android.permission.CAMERA)~\n~AddPermission(android.permission.VIBRATE)~\n~AddPermission(android.permission.MODIFY_AUDIO_SETTINGS)

#Region  Project Attributes 
	#ApplicationLabel: BWSI Collector's
	#VersionCode: 1
	#VersionName: Dev
	'SupportedOrientations possible values: unspecified, landscape or portrait.
	#SupportedOrientations: Portrait
	#CanInstallToExternalStorage: False
	
	'Dev Resources
	#AdditionalRes: C:\B4A\Dev\resource
	#AdditionalRes: C:\B4A\Dev\md-app\res
	#AdditionalRes: C:\B4A\Dev\md-lib\res
	#AdditionalRes: C:\B4A\Dev\resAX_CustomAlertViewDialog

	#AdditionalJar: com.google.android.material:material
	#AdditionalJar:WoosimLib251

	#Extends: android.support.v4.widget.DrawerLayout
	#Extends: android.support.v7.app.AppCompatActivity

	#MultiDex: True
	#BridgeLogger: True
#End Region

#Region  Activity Attributes 
	#FullScreen: True
	#IncludeTitle: True
#End Region

Sub Process_Globals
	'These global variables will be declared once when the application starts.
	'These variables can be accessed from all modules.
	Private xui As XUI
	
End Sub

Sub Globals
	'These global variables will be redeclared each time the activity is created.
	Private cdTxt As ColorDrawable
	Private btnLogin As ACButton
	Private btnShowHide As Label
	Private txtPassword As EditText
	Private txtUserName As EditText
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Activity.LoadLayout("Login")
	cdTxt.Initialize2(Colors.White,0,0,Colors.Transparent)
	InitControls
	txtUserName.Text = "joko0124"
	txtPassword.Text = "pogi"
End Sub

Sub Activity_Resume

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

#Region Objects
Private Sub InitControls
	txtUserName.Text = ""
	txtPassword.Text = ""
	txtUserName.Background = cdTxt
	txtPassword.Background = cdTxt
	DisableButton(btnLogin)
End Sub
Sub txtUserName_TextChanged (Old As String, New As String)
	If GlobalVar.SF.Len(txtPassword.Text) <= 0 Or GlobalVar.SF.Len(txtUserName.Text) <= 0 Then
		DisableButton(btnLogin)
	Else
		EnableButton(btnLogin)
	End If
End Sub

Sub txtPassword_TextChanged (Old As String, New As String)
	If GlobalVar.SF.Len(txtPassword.Text) <= 0 Or GlobalVar.SF.Len(txtUserName.Text) <= 0 Then
		DisableButton(btnLogin)
	Else
		EnableButton(btnLogin)
	End If
End Sub

Sub btnShowHide_Click
	
End Sub

Sub btnLogin_Click
	StartActivity(MainScreen)
End Sub
#End Region

#Region Styles
Private Sub EnableButton(v As View)
	Dim GradButton As GradientDrawable
	Dim Clrs(2) As Int
	Clrs(0) = 0xFF16406E
	Clrs(1) = 0xFF158CC4
	If Not(GradButton.IsInitialized) Then GradButton.Initialize("RIGHT_LEFT", Clrs)
	v.Background = GradButton
	v.Enabled = True
	
	Dim jo As JavaObject = v.Background
	If v.Background Is ColorDrawable Or v.Background Is GradientDrawable Then
		jo.RunMethod("setCornerRadii", Array As Object(Array As Float(80, 80, 80, 80, 80, 80, 80, 80)))
		jo.RunMethod("setStroke", Array As Object(3dip, 0xFFFFFFFF))
	End If
End Sub

Private Sub DisableButton(v As View)
	Dim GradButton As GradientDrawable
	Dim Clrs(2) As Int
	Clrs(0) = 0xFFA9A9A9
	Clrs(1) = 0xFFD3D3D3
	If Not(GradButton.IsInitialized) Then GradButton.Initialize("TL_BR",Clrs)
	v.Background = GradButton
	v.Enabled = False
	
	Dim jo As JavaObject = v.Background
	If v.Background Is ColorDrawable Or v.Background Is GradientDrawable Then
		jo.RunMethod("setCornerRadii", Array As Object(Array As Float(80, 80, 80, 80, 80, 80, 80, 80)))
		jo.RunMethod("setStroke", Array As Object(3dip, 0xFFFFFFFF))
	End If
End Sub
#End Region